{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "read-and-write",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "read-and-write",
      // 部署前替换为 `wrangler d1 create read-and-write` 输出的 database_id
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "migrations"
    }
  ]
}
