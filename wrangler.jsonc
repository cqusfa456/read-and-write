{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "read-and-write",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "read-and-write",
      "database_id": "2488ffd3-0919-472f-8f2c-05f83ba8f032",
      "migrations_dir": "migrations"
    }
  ]
}
